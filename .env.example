# Supabase project settings (Project Settings -> API in the Supabase dashboard).
# These are publishable values: they are safe to ship to the browser.
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
# Web Push public key (the matching private key is the VAPID_PRIVATE_KEY function secret)
VITE_VAPID_PUBLIC_KEY="your-vapid-public-key"
