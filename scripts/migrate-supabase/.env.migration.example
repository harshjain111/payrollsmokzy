# URL-encode special characters in the password (e.g. "$" -> "%24", "@" -> "%40").
SOURCE_DB_URL="postgresql://postgres:PASSWORD@db.xshnuzoqeoqwarvmsgef.supabase.co:5432/postgres"
SOURCE_SUPABASE_URL="https://xshnuzoqeoqwarvmsgef.supabase.co"
SOURCE_SERVICE_ROLE_KEY=""

